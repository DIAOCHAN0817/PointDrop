{
  "manifest_version": 3,

  "name": "PointDrop",

  "version": "0.3.0",

  "description": "Capture first, organize later.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],

      "js": [
        "content.js"
      ],

      "css": [
        "pointdrop.css"
      ],

      "run_at": "document_idle"
    }
  ]
}